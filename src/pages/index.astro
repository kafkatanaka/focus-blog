---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { filterPostsByLocale, sortPostsByDate, thumbnailPathFor } from '../lib/posts';
import { getArticlePath } from '../lib/locale';

const posts = sortPostsByDate(
  filterPostsByLocale(
    (await getCollection('blog')).filter((p) => !p.data.draft),
    'en'
  )
);
---

<BaseLayout
  title="The Focus Dividend"
  description="Readings on focus, attention, and intentional living. Minimal design, maximum clarity."
>
  <Header />
  <main class="mx-auto max-w-readable px-4 py-12 sm:px-6">
    <section class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        The Focus Dividend
      </h1>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Readings on focus, attention, and intentional living. Minimal design, maximum clarity.
      </p>
    </section>
    <ul class="space-y-8">
      {posts.map((post) => (
        <ArticleCard
          href={getArticlePath(post)}
          title={post.data.title}
          description={post.data.description}
          thumbnailPath={thumbnailPathFor(post)}
          tags={post.data.tags}
          locale="en"
        />
      ))}
    </ul>
  </main>
  <Footer />
</BaseLayout>
