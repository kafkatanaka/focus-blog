---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact"
  description="Contact The Focus Dividend. Get in touch with questions, feedback, or partnership inquiries."
>
  <Header />
  <main class="mx-auto max-w-readable px-4 py-12 sm:px-6">
    <article class="prose prose-lg max-w-none">
      <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Contact Us
      </h1>
      <p class="mt-4 text-gray-600 leading-relaxed">
        We&apos;d love to hear from you. Whether you have a question about our content, feedback on an article, or a partnership inquiry, feel free to reach out.
      </p>

      <h2 class="mt-8 text-xl font-semibold text-gray-900">How to Reach Us</h2>
      <p class="mt-2 text-gray-600 leading-relaxed">
        The best way to contact us is by email:
      </p>
      <p class="mt-2">
        <a href="mailto:contact@focus-dividend.com" class="text-gray-700 underline hover:text-gray-900 font-medium">
          contact@focus-dividend.com
        </a>
      </p>
      <p class="mt-2 text-gray-600 leading-relaxed">
        We typically respond within a few business days. For urgent matters, please indicate that in your subject line.
      </p>

      <h2 class="mt-8 text-xl font-semibold text-gray-900">What You Can Contact Us About</h2>
      <ul class="mt-2 list-disc pl-6 space-y-1 text-gray-600">
        <li>Questions about our articles or recommendations</li>
        <li>Feedback or suggestions for future content</li>
        <li>Privacy policy or data-related inquiries</li>
        <li>Affiliate or partnership opportunities</li>
        <li>Technical issues with the website</li>
      </ul>

      <p class="mt-8 text-sm text-gray-500">
        Thank you for visiting The Focus Dividend. We appreciate your interest and look forward to hearing from you.
      </p>
    </article>
  </main>
  <Footer />
</BaseLayout>
