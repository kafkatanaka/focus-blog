---
import { existsSync } from 'node:fs';
import BlogPost from '../layouts/BlogPost.astro';
import { getCollection } from 'astro:content';
import { getRelatedPosts } from '../lib/related-posts';
import { relatedMap } from '../data/related-map';
import { getArticlePath, isJapanesePost } from '../lib/locale';
import { filterPostsByLocale } from '../lib/posts';
import {
  getArticlePresentation,
  resolveReadingJourney,
} from '../lib/article-presentation';
import { readingMinutes } from '../lib/reading-time';
import { getActiveCtaSlots } from '../data/affiliate-offers';
import { buildArticleBreadcrumbs } from '../lib/breadcrumbs';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && !isJapanesePost(data));
  const reservedSlugs = ['focus', 'work', 'money', 'habits', 'about', 'articles', 'framework'];
  return posts
    .filter((entry) => !reservedSlugs.includes(entry.slug))
    .map((entry) => {
      const relatedPosts = getRelatedPosts(
        entry.slug,
        entry.data.tags ?? [],
        filterPostsByLocale(posts, 'en'),
        relatedMap
      );
      return {
        params: { slug: entry.slug },
        props: { entry, relatedPosts, allEnPosts: posts },
      };
    });
}

const { entry, relatedPosts, allEnPosts } = Astro.props;
const { Content, headings } = await entry.render();
const site = Astro.site ?? new URL('https://focus-dividend.com');
const canonicalURL = new URL(getArticlePath(entry), site);
const presentation = getArticlePresentation(entry, allEnPosts);
const journeySteps = resolveReadingJourney(
  presentation.readingJourney,
  'en',
  allEnPosts
);
const breadcrumbs = buildArticleBreadcrumbs(entry, 'en');

const thumbnailCandidate = entry.data.thumbnail
  ? `/images/thumbnails/${entry.data.thumbnail}`
  : `/images/thumbnails/${entry.slug}.webp`;
// Fall back to the placeholder at build time so og:image / twitter:image never 404.
const thumbnailPath = existsSync(`public${thumbnailCandidate}`)
  ? thumbnailCandidate
  : '/images/thumbnails/placeholder.webp';
const ogImage = new URL(thumbnailPath, site).href;
const minutes = readingMinutes(entry.body, 'en');
const hasPromotion = getActiveCtaSlots(entry.body).length > 0;
---

<BlogPost
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  category={entry.data.category}
  tags={entry.data.tags}
  ads={entry.data.ads}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
  thumbnailPath={thumbnailPath}
  relatedPosts={relatedPosts}
  presentation={presentation}
  breadcrumbs={breadcrumbs}
  journeySteps={journeySteps}
  headings={headings}
  seoTitle={entry.data.seo_title}
  readingMinutes={minutes}
  hasPromotion={hasPromotion}
>
  <Content />
</BlogPost>
