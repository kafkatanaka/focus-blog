---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CategoryEditorialMain from '../../components/CategoryEditorialMain.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_TITLES, CATEGORY_DESCRIPTIONS_JA } from '../../lib/categories';
import { filterPostsByLocale, sortPostsByDate } from '../../lib/posts';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
if (!category || !CATEGORIES.includes(category as (typeof CATEGORIES)[number])) {
  return Astro.redirect('/jp');
}

const allPosts = sortPostsByDate(
  filterPostsByLocale(
    (await getCollection('blog')).filter(
      (p) => !p.data.draft && p.data.category === category
    ),
    'ja'
  )
);

const pool = filterPostsByLocale(
  (await getCollection('blog')).filter((p) => !p.data.draft),
  'ja'
);
---

<BaseLayout
  lang="ja"
  title={`${CATEGORY_TITLES[category]} | 日本語版`}
  description={CATEGORY_DESCRIPTIONS_JA[category]}
>
  <Header locale="ja" />
  <main class="mx-auto max-w-editorial px-4 py-12 sm:px-6">
    <CategoryEditorialMain
      locale="ja"
      category={category}
      posts={allPosts}
      allPosts={pool}
      homeHref="/jp"
    />
  </main>
  <Footer locale="ja" />
</BaseLayout>
