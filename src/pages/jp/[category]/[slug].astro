---
import BlogPost from '../../../layouts/BlogPost.astro';
import { getCollection } from 'astro:content';
import { getRelatedPosts } from '../../../lib/related-posts';
import { relatedMap } from '../../../data/related-map';
import { isJapanesePost, getArticlePath, getLocaleSwitchUrl, buildHreflangAlternates, localeMetadataFromPost } from '../../../lib/locale';
import { filterPostsByLocale } from '../../../lib/posts';
import { CATEGORIES } from '../../../lib/categories';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft && isJapanesePost(data));
  const jaPosts = allPosts.filter((p) => p.data.category && CATEGORIES.includes(p.data.category as (typeof CATEGORIES)[number]));

  return jaPosts.map((entry) => {
    const pool = filterPostsByLocale(allPosts, 'ja');
    const relatedPosts = getRelatedPosts(
      entry.slug,
      entry.data.tags ?? [],
      pool,
      relatedMap
    );
    return {
      params: { category: entry.data.category!, slug: entry.slug },
      props: { entry, relatedPosts, allJaPosts: pool },
    };
  });
}

const { entry, relatedPosts, allJaPosts } = Astro.props;
const { Content } = await entry.render();
const site = Astro.site ?? new URL('https://focus-dividend.com');
const articlePath = getArticlePath(entry);
const canonicalURL = new URL(articlePath, site);
const localeMetadata = localeMetadataFromPost(entry.data);
const switchUrls = getLocaleSwitchUrl(articlePath, localeMetadata);
const hreflangAlternates =
  entry.data.alternate_locales?.en && entry.data.alternate_locales?.ja
    ? buildHreflangAlternates(
        {
          en: entry.data.alternate_locales.en,
          ja: entry.data.alternate_locales.ja,
        },
        site
      )
    : entry.data.english_url
      ? buildHreflangAlternates({ en: entry.data.english_url, ja: articlePath }, site)
      : undefined;

const thumbnailPath = entry.data.thumbnail
  ? `/images/thumbnails/${entry.data.thumbnail}`
  : `/images/thumbnails/${entry.slug}.webp`;
const ogImage = new URL(thumbnailPath, site).href;
---

<BlogPost
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  category={entry.data.category}
  tags={entry.data.tags}
  ads={entry.data.ads}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
  thumbnailPath={thumbnailPath}
  relatedPosts={relatedPosts}
  locale="ja"
  switchUrls={switchUrls}
  localeMetadata={localeMetadata}
  hreflangAlternates={hreflangAlternates}
>
  <Content />
</BlogPost>
