---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryEditorialMain from '../components/CategoryEditorialMain.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_TITLES, CATEGORY_DESCRIPTIONS } from '../lib/categories';
import { filterPostsByLocale, sortPostsByDate } from '../lib/posts';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
if (!category || !CATEGORIES.includes(category as (typeof CATEGORIES)[number])) {
  return Astro.redirect('/');
}

const allPosts = sortPostsByDate(
  filterPostsByLocale(
    (await getCollection('blog')).filter(
      (p) => !p.data.draft && p.data.category === category
    ),
    'en'
  )
);

const pool = filterPostsByLocale(
  (await getCollection('blog')).filter((p) => !p.data.draft),
  'en'
);
---

<BaseLayout
  title={CATEGORY_TITLES[category]}
  description={CATEGORY_DESCRIPTIONS[category]}
>
  <Header />
  <main class="mx-auto max-w-editorial px-4 py-12 sm:px-6">
    <CategoryEditorialMain
      locale="en"
      category={category}
      posts={allPosts}
      allPosts={pool}
      homeHref="/"
    />
  </main>
  <Footer />
</BaseLayout>
