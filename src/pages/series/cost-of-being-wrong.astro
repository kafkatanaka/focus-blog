---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const SERIES = 'cost-of-being-wrong';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.series === SERIES)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="The Cost of Being Wrong"
  description="Expensive mistakes. Quietly explained. Articles from the COBW editorial series on Focus Dividend."
>
  <Header />
  <main class="mx-auto max-w-readable px-4 py-10 sm:px-6">
    <header class="mb-10 border-b border-gray-200 pb-8">
      <p class="text-sm font-medium uppercase tracking-wide text-gray-500">Series</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-gray-900">The Cost of Being Wrong</h1>
      <p class="mt-3 text-lg text-gray-600">Expensive mistakes. Quietly explained.</p>
    </header>

    {posts.length === 0 ? (
      <p class="text-gray-600">COBW articles will appear here after you publish them from <a href="/admin/cobw" class="underline">/admin/cobw</a>.</p>
    ) : (
      <ul class="space-y-6">
        {posts.map((post) => (
          <li class="rounded-lg border border-gray-200 p-5 transition-colors hover:border-gray-300">
            <a href={`/${post.slug}`} class="group block">
              <h2 class="text-xl font-semibold text-gray-900 group-hover:underline">{post.data.title}</h2>
              <p class="mt-2 text-sm text-gray-600 line-clamp-2">{post.data.description}</p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs text-gray-500">
                {post.data.category && (
                  <span class="rounded bg-gray-100 px-2 py-0.5 capitalize">{post.data.category}</span>
                )}
                {post.data.youtube_video_id && (
                  <span class="rounded bg-gray-900 px-2 py-0.5 text-white">Video available</span>
                )}
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
  <Footer />
</BaseLayout>
