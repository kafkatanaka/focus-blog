---
interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: className } = Astro.props;
---

<section id={id} class:list={['scroll-mt-24', className]}>
  <h2 class="flex items-center gap-3 text-lg font-bold tracking-tight text-ink sm:text-xl">
    <span class="h-5 w-1 rounded-full bg-accent-500" aria-hidden="true"></span>{title}
  </h2>
  <div class="mt-6">
    <slot />
  </div>
</section>
