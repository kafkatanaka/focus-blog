---
import SearchModal from './SearchModal.astro';
import { getLocaleFromPath, type Locale } from '../lib/locale';
import { NAV_CATEGORY_SLUGS, CATEGORY_TITLES } from '../lib/categories';

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const base = locale === 'ja' ? '/jp' : '';
const homeHref = base || '/';

const NAV_TABS = NAV_CATEGORY_SLUGS.map((slug) => ({
  slug,
  href: `${base}/${slug}`,
  label: CATEGORY_TITLES[slug] ?? slug,
}));
---

<div class="sticky top-0 z-40 bg-white border-b border-gray-200">
  <header class="bg-white">
    <nav class="mx-auto flex max-w-readable items-center justify-between px-4 py-4 sm:px-6" aria-label="Main navigation">
      <a href={homeHref} class="text-xl font-bold text-gray-900 hover:text-gray-700">
        The Focus Dividend
      </a>
      <button
        type="button"
        onclick="window.openSearchModal?.()"
        class="rounded p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900"
        aria-label={locale === 'ja' ? '記事を検索' : 'Search articles'}
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
    </nav>
  </header>

  <nav class="border-t border-gray-100 bg-gray-50/80" aria-label="Category navigation">
    <div class="overflow-x-auto scrollbar-none scroll-smooth mx-auto max-w-readable" tabindex="0">
      <ul class="flex min-w-0 items-center gap-1 px-4 py-2 sm:px-6 sm:gap-2 w-max max-w-none">
        {NAV_TABS.map((tab) => {
          const isFramework = tab.slug === 'framework';
          const isActive =
            currentPath === tab.href ||
            (!isFramework && (currentPath.startsWith(`${tab.href}/`) || currentPath === tab.href));
          return (
            <li class="shrink-0">
              <a
                href={tab.href}
                class:list={[
                  'inline-block rounded-lg px-3 py-2 text-sm whitespace-nowrap transition-colors border-b-2',
                  isActive
                    ? 'border-gray-900 bg-white font-semibold text-gray-900 shadow-sm ring-1 ring-gray-200'
                    : 'border-transparent font-medium text-gray-600 hover:bg-white/60 hover:text-gray-900',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {tab.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>
</div>
<SearchModal locale={locale} />

<style>
  .scrollbar-none {
    -webkit-overflow-scrolling: touch;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    scrollbar-width: none;
  }
</style>
