---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdSense from '../components/AdSense.astro';
import RelatedReading from '../components/RelatedReading.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import ReadingJourney from '../components/ReadingJourney.astro';
import ArticleStructuredData from '../components/ArticleStructuredData.astro';
import type { RelatedPostItem } from '../lib/related-posts';
import type { CollectionEntry } from 'astro:content';
import type { Locale, LocaleMetadata } from '../lib/locale';
import { formatPublishedDate } from '../lib/locale';
import type { ArticlePresentation, ResolvedJourneyLink } from '../lib/article-presentation';
import { articleTypeLabel } from '../lib/article-presentation';
import type { Crumb } from '../lib/breadcrumbs';
import { canonicalUrl } from '../lib/site-url';
import { categoryLabel as catLabel } from '../lib/categories';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
  ads?: boolean;
  canonicalURL?: URL;
  ogImage?: string;
  thumbnailPath?: string;
  relatedPosts?: RelatedPostItem[];
  relatedPostEntries?: Pick<CollectionEntry<'blog'>, 'slug' | 'data'>[];
  locale?: Locale;
  categoryHref?: string;
  switchUrls?: { en: string; ja: string };
  localeMetadata?: LocaleMetadata;
  hreflangAlternates?: { en?: string; ja?: string };
  presentation?: ArticlePresentation;
  breadcrumbs?: Crumb[];
  journeySteps?: ResolvedJourneyLink[];
  headings?: { depth: number; slug: string; text: string }[];
  /** Search-facing <title> (frontmatter seo_title). Falls back to title. */
  seoTitle?: string;
  readingMinutes?: number;
  /** Article contains PR / affiliate links → show 景表法 (ステマ規制) notice. */
  hasPromotion?: boolean;
}

const {
  title,
  description,
  category,
  tags = [],
  ads = true,
  canonicalURL,
  ogImage,
  thumbnailPath,
  relatedPosts = [],
  relatedPostEntries,
  pubDate,
  updatedDate,
  locale = 'en',
  categoryHref,
  switchUrls,
  localeMetadata,
  hreflangAlternates,
  presentation,
  breadcrumbs = [],
  journeySteps = [],
  headings = [],
  seoTitle,
  readingMinutes,
  hasPromotion = false,
} = Astro.props;
const ja = locale === 'ja';

const resolvedCategoryHref =
  categoryHref ?? (locale === 'ja' && category ? `/jp/${category}` : category ? `/${category}` : undefined);

const typeLabel = presentation ? articleTypeLabel(presentation.articleType, locale) : null;
const categoryLabel = category ? catLabel(category, locale) : null;

const showUpdated =
  updatedDate &&
  pubDate &&
  updatedDate.getTime() - pubDate.getTime() > 24 * 60 * 60 * 1000;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 4;
let h2Index = 0;
const tocItems = tocHeadings.map((h) => ({ ...h, num: h.depth === 2 ? ++h2Index : null }));

const canonicalHref = canonicalURL
  ? canonicalUrl(canonicalURL.pathname)
  : undefined;

const schemaBreadcrumbs = breadcrumbs
  .filter((c) => c.href)
  .map((c) => ({ name: c.label, url: canonicalUrl(c.href!) }));
if (schemaBreadcrumbs.length > 0) {
  schemaBreadcrumbs.push({ name: title, url: canonicalHref ?? '' });
}

const journeyHeading = ja ? '次に読む' : 'What to read next';
const hubPartLabel = ja ? 'このテーマの入口' : 'Part of';
const disclosureHref = ja ? '/jp/affiliate-disclosure' : '/affiliate-disclosure';
---

<BaseLayout
  title={seoTitle ?? title}
  description={description}
  canonicalURL={canonicalURL}
  ogImage={ogImage}
  lang={locale}
  hreflangAlternates={hreflangAlternates}
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  section={categoryLabel ?? undefined}
>
  {canonicalHref && (
    <ArticleStructuredData
      title={title}
      description={description}
      url={canonicalHref}
      pubDate={pubDate}
      updatedDate={showUpdated ? updatedDate : undefined}
      breadcrumbs={schemaBreadcrumbs}
      image={ogImage}
      locale={locale}
      section={categoryLabel ?? undefined}
    />
  )}
  <div class="fd-progress" aria-hidden="true"></div>
  <Header locale={locale} contentWidth="readable" />
  <main class="mx-auto max-w-readable px-4 pb-16 pt-6 sm:px-6 sm:pt-8">
    <article>
      {breadcrumbs.length > 0 && <BreadcrumbNav items={breadcrumbs} locale={locale} />}

      <header class="mb-8">
        {(categoryLabel || typeLabel) && (
          <p class="fd-ui flex flex-wrap items-center gap-2 text-xs font-bold">
            {categoryLabel && resolvedCategoryHref && (
              <a href={resolvedCategoryHref} class="rounded-full bg-accent-50 px-3 py-1 text-accent-700 hover:bg-accent-100">
                {categoryLabel}
              </a>
            )}
            {typeLabel && <span class="tracking-wide text-gray-500">{typeLabel}</span>}
          </p>
        )}
        <h1 class="mt-4 text-[1.7rem] font-bold leading-snug tracking-tight text-ink sm:text-[2.15rem] sm:leading-tight">
          {title}
        </h1>
        <p class="mt-4 text-base leading-relaxed text-gray-600 sm:text-[1.075rem]">{description}</p>

        <div class="fd-ui mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 border-y border-gray-200 py-3 text-[0.8rem] text-gray-500">
          <span class="font-semibold text-gray-700">{ja ? 'The Focus Dividend 編集部' : 'The Focus Dividend Editors'}</span>
          {pubDate && (
            <time datetime={pubDate.toISOString()}>
              {ja ? '公開 ' : 'Published '}{formatPublishedDate(pubDate, locale)}
            </time>
          )}
          {showUpdated && updatedDate && (
            <time datetime={updatedDate.toISOString()}>
              {ja ? '更新 ' : 'Updated '}{formatPublishedDate(updatedDate, locale)}
            </time>
          )}
          {readingMinutes && (
            <span>{ja ? `約${readingMinutes}分で読めます` : `${readingMinutes} min read`}</span>
          )}
        </div>

        {hasPromotion && (
          <p class="fd-ui mt-3 text-xs leading-relaxed text-gray-500">
            <span class="mr-1.5 rounded border border-gray-400 px-1.5 py-px font-bold text-gray-600">PR</span>
            {ja ? (
              <>本記事にはプロモーション（広告）が含まれます。紹介内容は編集部の基準で作成しています。<a href={disclosureHref} class="underline hover:no-underline">広告掲載について</a></>
            ) : (
              <>This article contains affiliate links. <a href={disclosureHref} class="underline hover:no-underline">Disclosure</a></>
            )}
          </p>
        )}

        {presentation?.hubLink && !presentation.isHub && (
          <p class="fd-ui mt-4 text-sm text-gray-600">
            {hubPartLabel}:
            <a href={presentation.hubLink.href} class="ml-1 font-semibold text-accent-700 underline hover:no-underline">
              {presentation.hubLink.title}
            </a>
          </p>
        )}
        {thumbnailPath && !thumbnailPath.endsWith('/placeholder.webp') && (
          <img
            src={thumbnailPath}
            alt={title}
            class="mt-6 aspect-[1200/630] max-h-[300px] w-full rounded-lg object-cover"
            width="1200"
            height="630"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            onerror="this.onerror=null;this.src='/images/thumbnails/placeholder.webp'"
          />
        )}
      </header>

      {presentation?.keyTakeaway && (
        <div class="mb-8 rounded-lg border border-accent-100 bg-accent-50/60 p-5">
          <p class="fd-ui text-xs font-bold tracking-wide text-accent-700">
            {presentation.isHub ? (ja ? '要点' : 'Quick answer') : (ja ? 'この記事のポイント' : 'Key takeaway')}
          </p>
          <p class="mt-2 leading-relaxed text-gray-800">{presentation.keyTakeaway}</p>
        </div>
      )}

      {showToc && (
        <details class="fd-ui group mb-10 rounded-lg border border-[#e6e2da] bg-paper" open>
          <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-3.5 text-sm font-bold text-ink">
            <span>{ja ? '目次' : 'Contents'}</span>
            <span class="text-xs font-semibold text-gray-500 group-open:hidden">{ja ? '開く' : 'Show'}</span>
            <span class="hidden text-xs font-semibold text-gray-500 group-open:inline">{ja ? '閉じる' : 'Hide'}</span>
          </summary>
          <nav aria-label="Table of contents" class="border-t border-[#e6e2da] px-5 pb-4 pt-3">
            <ol class="space-y-1.5 text-sm">
              {tocItems.map((h) => (
                <li class={h.depth === 3 ? 'pl-7' : 'flex gap-2'}>
                  {h.num && <span class="w-5 shrink-0 text-right font-bold text-accent-600">{h.num}</span>}
                  <a href={`#${h.slug}`} class={h.depth === 3 ? 'text-gray-500 hover:text-accent-700' : 'text-gray-800 hover:text-accent-700'}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}

      {ads && <AdSense slot="4412571347" format="auto" />}

      <div class="fd-article prose prose-lg prose-gray max-w-none prose-headings:font-serif">
        <slot />
      </div>

      {ads && <div class="mt-10"><AdSense slot="4412571347" format="auto" /></div>}

      {tags.length > 0 && locale === 'en' && (
        <footer class="mt-12 border-t border-gray-200 pt-8">
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/tag/${encodeURIComponent(tag)}`}
                class="fd-ui rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700 transition-colors hover:bg-accent-50 hover:text-accent-700"
              >
                #{tag}
              </a>
            ))}
          </div>
        </footer>
      )}

      <section class="fd-ui mt-12 rounded-lg bg-paper p-5 text-sm leading-relaxed text-gray-600" aria-label={ja ? '編集方針' : 'Editorial policy'}>
        <p class="font-bold text-ink">{ja ? 'The Focus Dividend 編集部' : 'About The Focus Dividend'}</p>
        <p class="mt-1.5">
          {ja
            ? '仕事・お金・習慣の「迷い」を、答えを押し付けずに整理する読みものを届けています。制度や費用に関する記述は、公的機関や各社公式サイトの一次情報で確認しています。'
            : 'We write about attention, work, money and habits for people who want to decide with a clearer head. Claims about services are checked against official sources.'}
        </p>
        <p class="mt-2 text-xs">
          <a href={disclosureHref} class="underline hover:no-underline">{ja ? '広告掲載・編集方針について' : 'Affiliate disclosure'}</a>
        </p>
      </section>

      {journeySteps.length > 0 ? (
        <ReadingJourney steps={journeySteps} heading={journeyHeading} />
      ) : (
        <RelatedReading
          posts={relatedPosts}
          postEntries={relatedPostEntries}
          heading={ja ? '関連記事' : 'Related reading'}
        />
      )}
    </article>
  </main>
  <Footer locale={locale} switchUrls={switchUrls} metadata={localeMetadata} />
  <script is:inline>
    (function () {
      var bar = document.querySelector('.fd-progress');
      if (!bar) return;
      var ticking = false;
      function update() {
        var h = document.documentElement;
        var max = h.scrollHeight - h.clientHeight;
        bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(1, h.scrollTop / max) : 0) + ')';
        ticking = false;
      }
      addEventListener('scroll', function () {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
    })();
  </script>
</BaseLayout>
