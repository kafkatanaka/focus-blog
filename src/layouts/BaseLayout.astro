---
import { canonicalUrl, normalizePath } from '../lib/site-url';

interface Props {
  title: string;
  description: string;
  canonicalURL?: URL;
  ogImage?: string;
  noindex?: boolean;
  lang?: 'en' | 'ja';
  hreflangAlternates?: { en?: string; ja?: string };
}

const {
  title,
  description,
  canonicalURL,
  ogImage,
  noindex = false,
  lang = 'en',
  hreflangAlternates,
} = Astro.props;
const site = Astro.site ?? new URL('https://focus-dividend.com');
const pathForCanonical = canonicalURL
  ? normalizePath(canonicalURL.pathname)
  : normalizePath(Astro.url.pathname);
const fullURL = canonicalUrl(pathForCanonical);
const image = ogImage;
const homeHreflangEn = canonicalUrl('/');
const homeHreflangJa = canonicalUrl('/jp');
const showHomeHreflang =
  !hreflangAlternates &&
  (pathForCanonical === '/' || pathForCanonical === '/jp');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | The Focus Dividend</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={fullURL} />

    {hreflangAlternates?.en && (
      <link rel="alternate" hreflang="en" href={hreflangAlternates.en} />
    )}
    {hreflangAlternates?.ja && (
      <link rel="alternate" hreflang="ja" href={hreflangAlternates.ja} />
    )}
    {showHomeHreflang && (
      <>
        <link rel="alternate" hreflang="en" href={homeHreflangEn} />
        <link rel="alternate" hreflang="ja" href={homeHreflangJa} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullURL} />
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-2329837198490466" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2329837198490466"
      crossorigin="anonymous"
    ></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BMSV5WCPCM"></script>
    <script define:vars={{ gtagId: 'G-BMSV5WCPCM' }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gtagId);
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    {lang === 'ja' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700&display=swap"
          rel="stylesheet"
        />
      </>
    )}
  </head>
  <body class:list={['bg-white text-gray-900 font-serif antialiased', lang === 'ja' && 'locale-ja']}>
    <slot />
  </body>
</html>

<style is:global>
  /* Match EN editorial serif tone; Noto Serif JP replaces prior sans/JP UI stack */
  body.locale-ja {
    font-family: 'Noto Serif JP', Georgia, Cambria, 'Times New Roman', Times, serif;
  }
  body.locale-ja .prose {
    line-height: 1.85;
    font-family: inherit;
  }
  body.locale-ja .prose p {
    line-height: 1.9;
  }
  body.locale-ja .prose :where(h1, h2, h3, h4, strong) {
    font-family: inherit;
  }
</style>
