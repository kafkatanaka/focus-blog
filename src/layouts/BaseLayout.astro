---
import { canonicalUrl, normalizePath } from '../lib/site-url';
import '../styles/editorial.css';

interface Props {
  title: string;
  description: string;
  canonicalURL?: URL;
  ogImage?: string;
  noindex?: boolean;
  lang?: 'en' | 'ja';
  hreflangAlternates?: { en?: string; ja?: string };
  /** 'article' for posts (adds article:* OG tags). */
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
}

const {
  title,
  description,
  canonicalURL,
  ogImage,
  noindex = false,
  lang = 'en',
  hreflangAlternates,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  section,
} = Astro.props;
const site = Astro.site ?? new URL('https://focus-dividend.com');
const pathForCanonical = canonicalURL
  ? normalizePath(canonicalURL.pathname)
  : normalizePath(Astro.url.pathname);
const fullURL = canonicalUrl(pathForCanonical);
const SITE_NAME = 'The Focus Dividend';
const image = ogImage ?? new URL('/images/thumbnails/placeholder.webp', site).href;
// Avoid "Title | The Focus Dividend | The Focus Dividend" and keep JA titles tight.
const fullTitle = !title
  ? SITE_NAME
  : title.includes(SITE_NAME)
    ? title
    : `${title} | ${SITE_NAME}`;
const homeHreflangEn = canonicalUrl('/');
const homeHreflangJa = canonicalUrl('/jp');
const showHomeHreflang =
  !hreflangAlternates &&
  (pathForCanonical === '/' || pathForCanonical === '/jp');
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    )}
    <link rel="canonical" href={fullURL} />

    {hreflangAlternates?.en && (
      <link rel="alternate" hreflang="en" href={hreflangAlternates.en} />
    )}
    {hreflangAlternates?.ja && (
      <link rel="alternate" hreflang="ja" href={hreflangAlternates.ja} />
    )}
    {showHomeHreflang && (
      <>
        <link rel="alternate" hreflang="en" href={homeHreflangEn} />
        <link rel="alternate" hreflang="ja" href={homeHreflangJa} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullURL} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {ogType === 'article' && section && <meta property="article:section" content={section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-2329837198490466" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2329837198490466"
      crossorigin="anonymous"
    ></script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BMSV5WCPCM"></script>
    <script define:vars={{ gtagId: 'G-BMSV5WCPCM' }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gtagId);
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    {lang === 'ja' && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
          href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@400;600;700&display=swap"
          rel="stylesheet"
        />
      </>
    )}
  </head>
  <body class:list={['bg-white text-gray-900 font-serif antialiased', lang === 'ja' && 'locale-ja']}>
    <slot />
    <script is:inline>
      // Affiliate click tracking (GA4 event: affiliate_click)
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest && e.target.closest('a[data-aff-slot]');
        if (!a || typeof window.gtag !== 'function') return;
        window.gtag('event', 'affiliate_click', {
          slot: a.getAttribute('data-aff-slot'),
          offer: a.getAttribute('data-aff-name'),
          page_path: location.pathname,
          transport_type: 'beacon',
        });
      });
    </script>
  </body>
</html>
