---
import { existsSync } from 'node:fs';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** MDX pages using `layout:` receive their frontmatter here. */
  frontmatter?: { title?: string; description?: string };
}

const title = Astro.props.title ?? Astro.props.frontmatter?.title ?? 'The Focus Dividend';
const description = Astro.props.description ?? Astro.props.frontmatter?.description ?? '';
const site = Astro.site ?? new URL('https://focus-dividend.com');
// 記事と同じ命名規則: パスの最後のセグメントをスラッグとして {slug}.webp を参照
const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const slug = pathSegments[pathSegments.length - 1] ?? 'framework';
const thumb = existsSync(`public/images/thumbnails/${slug}.webp`) ? `/images/thumbnails/${slug}.webp` : '/images/thumbnails/placeholder.webp';
const ogImage = new URL(thumb, site).href;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <Header />
  <main class="mx-auto max-w-editorial px-4 py-12 sm:px-6 prose prose-gray max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-p:leading-relaxed prose-ul:my-6 prose-li:my-1 prose-a:text-gray-700 prose-a:underline hover:prose-a:text-gray-900">
    <slot />
  </main>
  <Footer />
</BaseLayout>
